# Application — aucune clé privée ne doit porter le préfixe NEXT_PUBLIC_
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=SaaScan
NEXT_PUBLIC_CONTACT_EMAIL=

# Identité du vendeur — à compléter avant ouverture commerciale
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_ADDRESS=
LEGAL_COMPANY_REGISTRATION=

# Supabase : Project settings → API ; appliquer les trois migrations avant usage.
# Auth n’est pas utilisé : le serveur accède à la base avec la clé service_role.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — modèle configurable, jamais appelé directement depuis le navigateur
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Stripe : commencer avec une clé de test ; aucun abonnement ni Price externe requis
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend : domaine expéditeur vérifié. L’email de paiement contient le lien du dossier.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SaaScan <bonjour@votre-domaine.fr>

# Secret long aléatoire pour /api/internal/retry-emails (Vercel Cron ou appel interne)
CRON_SECRET=
