# Application — aucune clé privée ne doit porter le préfixe NEXT_PUBLIC_
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=SaaScan
NEXT_PUBLIC_CONTACT_EMAIL=

# Identité du vendeur — à compléter avant ouverture commerciale
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_ADDRESS=
LEGAL_COMPANY_REGISTRATION=

# Supabase : Project settings → API ; appliquer les cinq migrations avant usage.
# Auth n’est pas utilisé : le serveur accède à la base avec la clé service_role.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Whop : clé API de l’entreprise. `node scripts/whop-catalogue.mjs` crée le produit et
# les trois formules, puis renseigne WHOP_PRODUCT_ID (référence) et WHOP_PLAN_* dans .env.local.
# WHOP_API_URL vide = production ; https://sandbox-api.whop.com/api/v1 pour le bac à sable.
# Le paiement exige une adresse HTTPS (NEXT_PUBLIC_APP_URL) pour le retour vers le dossier.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_API_URL=
WHOP_PRODUCT_ID=
WHOP_PLAN_MENSUEL=
WHOP_PLAN_TRIMESTRIEL=
WHOP_PLAN_ANNUEL=

# Resend : domaine expéditeur vérifié. L’email de paiement contient le lien du dossier.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SaaScan <bonjour@votre-domaine.fr>

# Secret long aléatoire pour /api/internal/retry-emails (Vercel Cron ou appel interne)
CRON_SECRET=
