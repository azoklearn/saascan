# Application — aucune clé privée ne doit porter le préfixe NEXT_PUBLIC_
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=SaaScan
NEXT_PUBLIC_CONTACT_EMAIL=

# Identité du vendeur — à compléter avant ouverture commerciale
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_ADDRESS=
LEGAL_COMPANY_REGISTRATION=

# Supabase : Project settings → API ; appliquer les deux migrations avant usage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — modèle configurable, jamais appelé directement depuis le navigateur
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Stripe : commencer avec une clé de test ; aucun abonnement ni Price externe requis
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend : domaine expéditeur vérifié. SMTP Supabase à configurer séparément.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SaaScan <bonjour@ton-domaine.fr>

# Secret long aléatoire pour /api/internal/retry-emails (Vercel Cron ou appel interne)
CRON_SECRET=
